OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=1200
# Required on reasoning models (e.g. google/gemini-3.7-flash), where thinking
# tokens are billed against MAX_TOKENS and would otherwise truncate the answer.
# One of: minimal, low, medium, high. Leave empty for non-reasoning models.
OPENROUTER_REASONING_EFFORT=

FINNHUB_API_KEY=
